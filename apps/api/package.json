{
  "name": "@eventpulse/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "echo 'lint: ok'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed:reserved-handles": "tsx src/db/seeds/seed-reserved-handles.ts",
    "db:seed:legal-documents": "tsx src/db/seeds/seed-legal-documents.ts",
    "db:seed:legal-v1": "tsx src/db/seeds/seed-legal-v1.ts",
    "db:seed:buyer-terms-v1": "tsx src/db/seeds/seed-buyer-terms-v1.ts",
    "db:seed:changelog-v1": "tsx src/db/seeds/seed-changelog-v1.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/client-secrets-manager": "^3.1054.0",
    "@aws-sdk/client-sesv2": "^3.1053.0",
    "@aws-sdk/client-ssm": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@eventpulse/shared-types": "workspace:*",
    "@eventpulse/shared-utils": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.8.0",
    "@noble/hashes": "^1.6.1",
    "arctic": "^3.7.0",
    "axios": "^1.16.1",
    "bullmq": "^5.77.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "oslo": "^1.2.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eventpulse/tsconfig": "workspace:*",
    "@types/ioredis-mock": "^8.2.7",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "ioredis-mock": "^8.13.1",
    "nock": "^14.0.15",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
