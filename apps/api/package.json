{
  "name": "@eventpulse/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "echo 'lint: ok'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed:reserved-handles": "tsx src/db/seeds/seed-reserved-handles.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/client-sesv2": "^3.1049.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@eventpulse/shared-types": "workspace:*",
    "@eventpulse/shared-utils": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.8.0",
    "@noble/hashes": "^1.6.1",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.19",
    "jose": "^5.9.6",
    "oslo": "^1.2.1",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eventpulse/tsconfig": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.22.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
