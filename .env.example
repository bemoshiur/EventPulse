# Event Pulse — environment template
# Copy to .env.local for local dev; production secrets live in AWS Secrets Manager.

# --- Core ---
NODE_ENV=development
EVENTPULSE_BASE_URL=http://localhost:3000
EVENTPULSE_API_BASE_URL=http://localhost:4000

# --- Database ---
DATABASE_URL=postgres://eventpulse:eventpulse@localhost:5432/eventpulse

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- EPS Bangladesh (production from day one — sandbox for local) ---
EPS_MERCHANT_ID=
EPS_STORE_ID=
EPS_USERNAME=
EPS_PASSWORD=
EPS_HASH_KEY=
EPS_MODE=sandbox

# --- OAuth: Google ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- OAuth: Apple ---
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

# --- AWS / SES / S3 ---
AWS_REGION=ap-southeast-1
AWS_SES_FROM=Event Pulse <hello@eventpulse.com.bd>
KYC_DOCS_BUCKET=eventpulse-kyc-docs-dev
KYC_DOCS_KMS_KEY_ID=
# Public event-asset bucket (cover images + tenant logos). Public-read on the
# assets/* prefix only. Code defaults to the prod bucket when unset (single-env);
# set explicitly when a second environment exists. Provisioned by
# infra/scripts/setup-assets-bucket.sh.
ASSETS_BUCKET_NAME=eventpulse-assets-prod-739275468267

# --- SMS (SSL Wireless) ---
SSL_WIRELESS_API_KEY=
SSL_WIRELESS_SENDER_ID=EVENTPULSE

# --- KYC providers ---
POROCHOY_API_KEY=
POROCHOY_BASE_URL=https://api.porichoy.gov.bd

# --- Sentry ---
SENTRY_DSN=
